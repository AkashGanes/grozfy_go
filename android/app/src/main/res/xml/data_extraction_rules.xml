<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ (API 31+) uses android:dataExtractionRules. Same intent as
  backup_rules.xml: keep flutter_secure_storage's encrypted SharedPreferences
  file out of cloud-backup AND device-to-device transfer flows. Restoring
  it on a new device or after a Keystore master key rotation produces an
  undecryptable blob and silently logs the user out.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="FlutterSecureStorage.xml" />
        <exclude domain="sharedpref" path="VGsyhUc5MgGRAilOwoP0d8.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="FlutterSecureStorage.xml" />
        <exclude domain="sharedpref" path="VGsyhUc5MgGRAilOwoP0d8.xml" />
    </device-transfer>
</data-extraction-rules>
